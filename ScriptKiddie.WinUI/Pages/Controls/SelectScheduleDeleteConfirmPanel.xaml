<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScriptKiddie.WinUI.Pages.Controls.SelectScheduleDeleteConfirmPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI.Pages.Controls"
    xmlns:models="using:ScriptKiddie.WinUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel Spacing="10">
            <TextBlock Text="此操作不可逆。" Margin="5"/>
            <StackPanel Visibility="{x:Bind ViewModel.NeedRemoveTask, Converter={StaticResource BoolToVisibilityConverter}}"
                Spacing="0">
                <InfoBar IsOpen="True" Title="注意" Message="删除之后，以下关联的选课任务将被删除。" 
                 IsClosable="False" Severity="Warning"/>
                <ListView ItemsSource="{x:Bind ViewModel.SelectTasksToRemove}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CourseSelectTask">
                            <StackPanel Margin="0, 12">
                                <TextBlock Text="{x:Bind Course}"/>
                                <TextBlock Text="{x:Bind OperationType, Converter={StaticResource OperationTypeToStringConverter}}"/>
                                <TextBlock Text="{x:Bind SelectStatus, Converter={StaticResource SelectStatusToStringConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</UserControl>
