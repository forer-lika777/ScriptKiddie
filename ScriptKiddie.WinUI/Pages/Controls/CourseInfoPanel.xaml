<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ScriptKiddie.WinUI.Pages.Controls.CourseInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI.Pages.Controls"
    xmlns:converters="using:ScriptKiddie.WinUI.Utils.Converters"
    xmlns:models="using:ScriptKiddie.WinUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <ScrollView HorizontalScrollMode="Enabled">
        <StackPanel>
            <TextBlock Text="注：某些字段的信息可能会过时" Margin="10"/>
            <ListView ItemsSource="{x:Bind CoursePropertyList}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyDisplayItem">
                        <TextBlock Margin="0, 10, 0, 0" TextWrapping="Wrap" LineHeight="25">
                            <Run Text="{x:Bind DisplayName}"/>
                            <Run>: </Run>
                            <Run Text="{x:Bind Value}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollView>
</UserControl>
