<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScriptKiddie.WinUI.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="H1Content" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="0, 20, 0, 10"/>
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style.Setters>
        </Style>
        <Style x:Key="H2Content" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="0, 18, 0, 4"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style.Setters>
        </Style>
        <Style x:Key="TextContent" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style.Setters>
        </Style>
        <Style x:Key="ListContent" TargetType="ContentControl">
            <Style.Setters>
                <Setter Property="Margin" Value="4, 2, 0, 2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE915;" FontSize="12" Margin="0,4,4,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid Opacity="0.6">
            <Image x:Name="BackgroundImage" Source="/Assets/100066396_p0.png" Stretch="UniformToFill"/>
        </Grid>
        <Grid Margin="100" HorizontalAlignment="Stretch" MaxWidth="1000" MaxHeight="600">
            <Rectangle Fill="{StaticResource AcrylicBackgroundFillColorDefaultBrush}" Translation="0, 0, 100" RadiusX="10" RadiusY="10">
                <Rectangle.Shadow>
                    <ThemeShadow/>
                </Rectangle.Shadow>
            </Rectangle>
            <Grid Padding="20, 10">
                <SelectorBar x:Name="TabSelectorBar" SelectionChanged="TabSelectorBar_SelectionChanged">
                </SelectorBar>

                <Grid x:Name="ContentGrid" Margin="0, 60" Padding="20, 0, 20, 20">
                    <ScrollView x:Name="Tab1Content">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1Content}">欢迎</TextBlock>
                            <TextBlock Style="{StaticResource TextContent}">欢迎来到 ScriptKiddie！</TextBlock>
                            <TextBlock Style="{StaticResource TextContent}">阅读以下文字以获悉此应用的详细信息。</TextBlock>
                            <TextBlock Style="{StaticResource H2Content}">什么是 ScriptKiddie？</TextBlock>
                            <TextBlock Style="{StaticResource TextContent}">ScriptKiddie 是 forer4433 在广东工业大学抢课的 Windows 桌面应用，使用 WinUI 3/C# 编写。</TextBlock>
                            <TextBlock Style="{StaticResource TextContent}">ScriptKiddie 并非 forer4433 专用，任何人都可以使用 ScriptKiddie 来进行自动化抢课。</TextBlock>
                        </StackPanel>
                    </ScrollView>
                    <ScrollView x:Name="Tab2Content">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1Content}">使用条款 · 声明</TextBlock>
                            <TextBlock Style="{StaticResource TextContent}">在使用本应用之前，你需要阅读并同意以下声明：</TextBlock>
                            <ContentControl Style="{StaticResource ListContent}">ScriptKiddie 是一个独立开发的开源项目。你只能将其用于学习研究和交流分享，不能用于其他任何商业或非法用途。</ContentControl>
                            <ContentControl Style="{StaticResource ListContent}">ScriptKiddie 是一个抢课应用，你自愿将账户权限交给具有一定风险的程序自动化抢课处理。开发者不保证抢课的成功，也不对你的行为和后果负责。你使用本应用产生的任何后果必须由你自行承担。</ContentControl>
                            <ContentControl Style="{StaticResource ListContent}">你需要使用学校的账户和密码来登录应用。开发者承诺，ScriptKiddie 在本地加密保存你的账户名、密码和 Cookie。ScriptKiddie 永远不会执行除选课和退选课以外的任何操作。ScriptKiddie 永远不会向除教务系统和学校官方网站外的任何第三方人员和机构发送这些敏感数据。如果你不信任开发者，请退出本应用。</ContentControl>
                        </StackPanel>
                    </ScrollView>
                    <ScrollView x:Name="Tab3Content">
                        <local:LoginPage/>
                    </ScrollView>
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="30" Spacing="20">
                    <Button x:Name="PreviousButton" Content="上一步" Width="200" Style="{StaticResource AccentButtonStyle}" Click="PreviousButton_Click"/>
                    <Button x:Name="NextButton" Content="下一步" Width="200" Style="{StaticResource AccentButtonStyle}" Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
