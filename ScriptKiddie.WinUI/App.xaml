<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ScriptKiddie.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI"
    xmlns:converters="using:ScriptKiddie.WinUI.Utils.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToReversedVisibilityConverter x:Key="BoolToReversedVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <converters:SelectStatusToStringConverter x:Key="SelectStatusToStringConverter"/>
            <converters:SelectTypeToStringConverter x:Key="SelectTypeToStringConverter"/>
            <converters:OperationTypeToStringConverter x:Key="OperationTypeToStringConverter"/>

            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>

            <Style TargetType="TextBlock" x:Key="H1Text">
                <Style.Setters>
                    <Setter Property="FontSize" Value="25"/>
                    <Setter Property="Margin" Value="0, 20"/>
                </Style.Setters>
            </Style>
            <Style TargetType="TextBlock" x:Key="H2Text">
                <Style.Setters>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Margin" Value="0, 10"/>
                </Style.Setters>
            </Style>
            <Style TargetType="TextBlock" x:Key="ContentText">
                <Style.Setters>
                </Style.Setters>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
