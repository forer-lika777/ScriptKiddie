<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI.Views"
    xmlns:converters="using:ScriptKiddie.WinUI.Views.Converters">

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:BoolToReversedVisibilityConverter x:Key="BoolToReversedVisibilityConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

    <converters:TextToVisibilityConverter x:Key="TextToVisibilityConverter"/>

    <converters:SelectStatusToStringConverter x:Key="SelectStatusToStringConverter"/>
    <converters:SelectTypeToStringConverter x:Key="SelectTypeToStringConverter"/>
    <converters:OperationTypeToStringConverter x:Key="OperationTypeToStringConverter"/>

    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
