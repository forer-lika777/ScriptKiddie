<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScriptKiddie.WinUI.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptKiddie.WinUI.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ScriptKiddie.WinUI.Views.Converters"
    xmlns:Interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ScriptKiddie.WinUI.Views/ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:UriToImageSourceConverter x:Key="UriToImageSourceConverter"/>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <ProgressBar 
            VerticalAlignment="Top" IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.LoginCommand.IsRunning, Mode=OneWay}"/>
        <StackPanel HorizontalAlignment="Center" Spacing="15" Margin="0, 30, 0, 100" Width="400">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal">
                    <TextBox 
                        x:Name="UserNameTextBox" 
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Header="账户名" PlaceholderText="请输入账户名" 
                        InputScope="Number" Width="360"
                        IsEnabled="{x:Bind ViewModel.LoginCommand.IsRunning, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                        KeyDown="UserNameTextBox_KeyDown"/>
                    <FontIcon 
                        Margin="10, 30, 0, 0" Glyph="&#xE814;" Foreground="Orange"
                        ToolTipService.ToolTip="{x:Bind ViewModel.UserNameError.Message, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.UserNameError.Success, Converter={StaticResource BoolToReversedVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <PasswordBox 
                        x:Name="PasswordBox"
                        Password="{x:Bind ViewModel.Password, Mode=TwoWay}" 
                        Header="密码" PlaceholderText="请输入密码" 
                        Width="360" HorizontalAlignment="Left"
                        IsEnabled="{x:Bind ViewModel.LoginCommand.IsRunning, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                        KeyDown="PasswordBox_KeyDown"/>
                    <FontIcon 
                        Margin="10, 30, 0, 0" Glyph="&#xE814;" Foreground="Orange"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PasswordError.Message, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.PasswordError.Success, Converter={StaticResource BoolToReversedVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Visibility="{x:Bind ViewModel.NeedCaptcha, Mode=OneWay}" MaxHeight="64" Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="CaptchaTextBox"
                            Grid.Column="0" Text="{x:Bind ViewModel.Captcha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Header="验证码" PlaceholderText="请输入验证码"
                            IsEnabled="{x:Bind ViewModel.LoginCommand.IsRunning, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                            KeyDown="CaptchaTextBox_KeyDown"/>
                        <Image 
                            Grid.Column="1" Source="{x:Bind ViewModel.CaptchaImage, Mode=OneWay, Converter={StaticResource UriToImageSourceConverter}}" 
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxHeight="32">
                            <Interactivity:Interaction.Behaviors>
                                <Interactivity:EventTriggerBehavior EventName="Tapped">
                                    <Interactivity:InvokeCommandAction Command="{x:Bind ViewModel.RefreshCaptchaCommand}"/>
                                </Interactivity:EventTriggerBehavior>
                            </Interactivity:Interaction.Behaviors>
                        </Image>
                    </Grid>
                    <FontIcon 
                        Margin="10, 30, 0, 0" Glyph="&#xE814;" Foreground="Orange"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CaptchaError.Message, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CaptchaError.Success, Converter={StaticResource BoolToReversedVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock 
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Message, Converter={StaticResource TextToVisibilityConverter}, Mode=OneWay}"
                HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0, 16, 30, 0"/>
            <Button 
                Content="登录" HorizontalAlignment="Left" Margin="0, 18, 0, 0" Width="360"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.LoginCommand}"/>
        </StackPanel>
    </Grid>
</Page>
